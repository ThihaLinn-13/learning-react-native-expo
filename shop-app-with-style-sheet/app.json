{
  "expo": {
    "name": "shop-app-with-style-sheet",
    "slug": "shop-app-with-style-sheet",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/images/M-app-icon.png",
    "scheme": "shopappwithstylesheet",
    "userInterfaceStyle": "light",
    "ios": {
      "icon": "./assets/expo.icon"
    },
    "android": {
      "adaptiveIcon": {
        "backgroundColor": "#E6F4FE",
        "foregroundImage": "./assets/images/android-icon-foreground.png",
        "backgroundImage": "./assets/images/android-icon-background.png",
        "monochromeImage": "./assets/images/android-icon-monochrome.png"
      },
      "predictiveBackGestureEnabled": false,
      "package": "com.thihalinn.shopappwithstylesheet"
    },
    "web": {
      "output": "server",
      "favicon": "./assets/images/favicon.png"
    },
    "plugins": [
      "expo-router",
      [
        "expo-splash-screen",
        {
          "backgroundColor": "#208AEF",
          "image": "./assets/images/splash-icon.png",
          "imageWidth": 76
        }
      ],
      [
        "expo-font",
        {
          "fonts": [
            "./assets/fonts/Fredoka-Regular.ttf",
            "./assets/fonts/SpecialGothicCondensedOne-Regular.ttf"
          ]
        }
      ],
      [
        "expo-status-bar",
        {
          "hidden": true,
          "style": "dark"
        }
      ]
    ],
    "experiments": {
      "typedRoutes": true,
      "reactCompiler": true
    },
    "extra": {
      "router": {
        "asyncRoutes": {
          "web": true
        }
      },
      "eas": {
        "projectId": "9a69771f-8cd0-4f7c-adb6-dd21d8b28fbd"
      }
    }
  }
}
